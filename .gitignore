# .gitignore

# --- Dependencias de Node.js ---
# La carpeta más importante a ignorar
node_modules/
npm-debug.log
package-lock.json

# --- Dependencias y caché de Python ---
venv/
.venv/
__pycache__/
*.pyc

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db

# --- Archivos de Vagrant ---
# Para que nunca subas el estado de tus VMs
.vagrant/

# --- Archivos de Log y compilados ---
*.log
*.log*

# --- Archivos de variables de entorno y secretos ---
.env
*.env
*.env.*
!*.env.example
arc-secrets.env
*.pem
*.key

# ---Archivos de Terraform---
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfplan
.terraform.lock.hcl
# --- Archivos de Docker ---
docker-compose.override.yml
docker-compose.prod.yml
docker-compose.dev.yml
# --- Archivos de configuración de Visual Studio Code ---
.vscode/
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json

# --- Configuraciones locales y temporales ---
.vscode/mcp.json
.vscode/mcp.lock.json
guidelines.md
product.md
structure.md
tech.md
AGENTS.md

# Estado local de Terraform - NUNCA commitear
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Variables con secrets
terraform.tfvars

# Directorio de providers
.terraform/
.terraform.lock.hcl

# Planes
*.tfplan
tfplan

#--- Archivos teoricos y de ejecucion ---#
README-ejecucion.md
README-teoria.md

#--- Teoria diaria ---#
daily-exercises/teoria diaria

#--- Local Agent & Skill Metadata ---#
.atl/
.kiro/
.engram/